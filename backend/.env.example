# Crime-Bot ETL Backend

DATABASE_URL=postgresql://postgres:police123@127.0.0.1:5432/crime_db
SOURCE_SCHEMA=public
CLEAN_SCHEMA=clean
LOG_DIR=app/etl/logs
REPORT_DIR=app/etl/reports
BATCH_SIZE=10000
ETL_WORKERS=4

# Evidence column detection patterns (comma-separated)
# Columns matching these patterns will NOT be text-cleaned
EVIDENCE_COLUMN_PATTERNS=narrative,evidence,description,remarks,statement,fir_content,complaint_text

# Coordinate column patterns (comma-separated, auto-detected)
LATITUDE_PATTERNS=latitude,lat,coord_lat
LONGITUDE_PATTERNS=longitude,lon,lng,coord_lon

# ── Neo4j Database Configuration ──────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# ── AI Document Generation ────────────────────────────────────────
DOCUMENT_STORE_PATH=app/document_generation/store
DOCUMENT_BATCH_SIZE=5000
MAX_DOCUMENT_LENGTH=10000

# ── Embedding Platform ────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=256
EMBEDDING_DEVICE=cpu
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=crime_intelligence
TOP_K=10

# ── Retrieval Engine ──────────────────────────────────────────────
DEFAULT_SCORE_THRESHOLD=0.5
QUERY_CACHE_SIZE=256
QUERY_CACHE_TTL=300
MAX_CONTEXT_TOKENS=4000
DEFAULT_DOCUMENT_LIMIT=20
