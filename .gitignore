# ==============================================================================
# Karnataka Police Crime Intelligence Platform — .gitignore
# ==============================================================================

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.docker.example
*.pem
*.key
*.cert
secrets.toml
.streamlit/secrets.toml

# ── Virtual Environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Python Bytecode & Packaging ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.manifest
*.spec

# ── Testing, Coverage & Linters ───────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
nosetests.xml
*.cover
*.py,cover
.tox/
test_reports/

# ── IDEs & Code Editors ───────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ── Vector DB & Local Storage (Qdrant) ────────────────────────────────────────
qdrant_storage/
**/qdrant_storage/
qdrant_storage.zip
qdrant_storage.tar.gz
*.snapshot
snapshots/

# ── Raw Datasets & Local Data Dumps ───────────────────────────────────────────
datafiles/
data/
datasets/
*.xlsx
*.xls

# ── Large Generated Document Stores & ETL Artifacts ───────────────────────────
backend/app/document_generation/store/
app/document_generation/store/
backend/app/etl/logs/
backend/app/etl/reports/
app/etl/logs/
app/etl/reports/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── ML Models & HuggingFace Cache ─────────────────────────────────────────────
.cache/
*.cache
huggingface/
models/
*.bin
*.safetensors
*.pt
*.pth
*.onnx

# ── Streamlit & Frontend Tooling ──────────────────────────────────────────────
.streamlit/*.local.toml
node_modules/
.next/
.nuxt/

# ── Databases & SQL Dumps ─────────────────────────────────────────────────────
*.sqlite3
*.sqlite
*.db
*.dump
*.sql.bak

# ── Jupyter Notebooks ─────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Operating System Artifacts ────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Temporary & Backup Files ──────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
