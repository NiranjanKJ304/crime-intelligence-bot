# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values before running docker compose up -d
# ==============================================================================

# ── Application ───────────────────────────────────────────────────
APP_NAME="Crime-Bot Backend"
APP_VERSION="0.1.0"
DEBUG=False
LOG_LEVEL=INFO

# ── Database (PostgreSQL) ─────────────────────────────────────────
DATABASE_URL=postgresql://crime_user:crime_password@postgres:5432/crime_db
POSTGRES_USER=crime_user
POSTGRES_PASSWORD=crime_password
POSTGRES_DB=crime_db

# ── ETL Schema Configuration ──────────────────────────────────────
SOURCE_SCHEMA=public
CLEAN_SCHEMA=clean
BATCH_SIZE=10000
ETL_WORKERS=4

# ── Neo4j Knowledge Graph ─────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=supersecret_neo4j_password

# ── AI Document Generation ────────────────────────────────────────
DOCUMENT_STORE_PATH=/app/app/document_generation/store
DOCUMENT_BATCH_SIZE=5000
MAX_DOCUMENT_LENGTH=10000

# ── Embedding Platform (Qdrant) ───────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=256
EMBEDDING_DEVICE=cpu
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=crime_intelligence
TOP_K=10

# ── Retrieval Engine ──────────────────────────────────────────────
DEFAULT_SCORE_THRESHOLD=0.5
QUERY_CACHE_SIZE=256
QUERY_CACHE_TTL=300
MAX_CONTEXT_TOKENS=4000
DEFAULT_DOCUMENT_LIMIT=20

# ── LLM / RAG ────────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
MODEL_NAME=llama-3.3-70b-versatile
TEMPERATURE=0.2
MAX_TOKENS=4096
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
MAX_CONTEXT_DOCUMENTS=10
